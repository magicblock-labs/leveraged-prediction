# The app always uses live state. Base RPC provides durable state, the router provides delegation
# discovery, and the returned ER endpoint for Market/oracle/UserPositions reads.
SOLANA_RPC_ENDPOINT=https://rpc.magicblock.app/devnet
ROUTER_ENDPOINT=https://devnet-router.magicblock.app/
LEVERAGED_PREDICTION_PROGRAM_ID=AcvFWjSFrLAAWMynqQmBxeBe8wHRTVhhHtB6byatQLFr
LEVERAGED_PREDICTION_MARKET_ID=1

# The same non-secret endpoints/addresses are exposed to the browser for
# wallet-signed setup and ER transactions. Never place RPC secrets here.
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=https://rpc.magicblock.app/devnet
NEXT_PUBLIC_ROUTER_ENDPOINT=https://devnet-router.magicblock.app/
NEXT_PUBLIC_LEVERAGED_PREDICTION_PROGRAM_ID=AcvFWjSFrLAAWMynqQmBxeBe8wHRTVhhHtB6byatQLFr
NEXT_PUBLIC_LEVERAGED_PREDICTION_MARKET_ID=1
# One-time protocol table created by `pnpm bootstrap:devnet`; required only when a fresh wallet's
# combined session/account/collateral setup exceeds the legacy transaction size limit.
# NEXT_PUBLIC_SESSION_SETUP_LOOKUP_TABLE=

# Optional authenticated websocket proxy. When present, the connected wallet
# signs the proxy challenge once per page session; its token stays in memory.
# NEXT_PUBLIC_ER_STREAM_RPC_ENDPOINT=http://127.0.0.1:6699
# NEXT_PUBLIC_ER_STREAM_WS_ENDPOINT=ws://127.0.0.1:6700

# Optional read-only Rust indexer API for leaderboard and historical user stats.
# NEXT_PUBLIC_INDEXER_API_URL=http://127.0.0.1:8080

# Optional faster snapshot polling for explicit local-validator tests.
# NEXT_PUBLIC_LIVE_SNAPSHOT_INTERVAL_MS=250

# Optional read-only Rust indexer API. History and leaderboards are hidden when omitted; live
# chart, active positions, wallet setup, and Up/Down submissions never depend on this service.
# NEXT_PUBLIC_INDEXER_API_URL=http://127.0.0.1:8080

# Optional override. When omitted, the mint is decoded from ProtocolConfig.
# LEVERAGED_PREDICTION_COLLATERAL_MINT=

# Server-only devnet faucet. Development enables it automatically for the trusted devnet RPCs above;
# production requires the explicit flag. Never expose either authority value through NEXT_PUBLIC_*.
DEVNET_FAUCET_ENABLED=1
# Vercel: base64-encode the 64-byte keypair file (the JSON file itself is accepted) and store the
# result in this encrypted server-only variable. This takes precedence over the local path.
DEVNET_FAUCET_AUTHORITY_BASE64=
# Local development fallback; filesystem paths are not available in Vercel deployments.
# DEVNET_FAUCET_AUTHORITY_PATH=~/.config/solana/id.json
