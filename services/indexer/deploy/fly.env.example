# Import these values as Fly secrets. Never commit the populated fly.env file.
#
# Use the Supabase direct connection (port 5432), including sslmode=require. The shared
# session pooler on port 5432 is also compatible when direct IPv6 is unavailable. Do not use a
# transaction-mode URL on port 6543: the API holds a session for PostgreSQL LISTEN/NOTIFY.
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres:<percent-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# First confirmed slot whose program deployment emits the checked v2 event ABI.
INDEXER_V2_MIN_SLOT=<confirmed-v2-activation-slot>

# Comma-separated exact origins. Do not use a wildcard.
API_CORS_ORIGINS=https://<frontend-host>
